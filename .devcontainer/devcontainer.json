{
  "name": "docker-playlist-manager",
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-trixie",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Playlist Manager", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -r requirements.txt -r requirements-dev.txt && python scripts/generate_mock_data.py",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy", "charliermarsh.ruff"]
    }
  }
}
